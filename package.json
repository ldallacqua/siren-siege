{
  "name": "siren-siege",
  "version": "0.2.0",
  "description": "Siren Siege — browser tower defense where your towers are anime heroines.",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node --experimental-strip-types --no-warnings scripts/balance-sim.ts",
    "fx": "npm run build && node --experimental-strip-types --no-warnings scripts/fx-preview.ts",
    "smoke": "npm run build && node --experimental-strip-types --no-warnings scripts/smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run sim && vite build",
    "shots": "npm run build && node --experimental-strip-types --no-warnings scripts/readme-shots.ts",
    "art": "node --experimental-strip-types --no-warnings scripts/art-import.ts && npm run --silent art:check",
    "art:check": "node --experimental-strip-types --no-warnings scripts/art-check.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.20.5",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  }
}
